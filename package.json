{
  "name": "n8n-nodes-scento-perfume",
  "version": "0.1.0",
  "description": "n8n community node for the free Scento Perfume API: perfume notes and profiles, similar perfumes, raw materials, houses, scent families and the Scento journal. No API key, no account.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "perfume api",
    "fragrance api",
    "perfume database",
    "perfume",
    "fragrance",
    "perfume-notes",
    "scento"
  ],
  "license": "MIT",
  "homepage": "https://www.scento.com/developers",
  "author": {
    "name": "Scento",
    "email": "contact@scento.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scento-com/n8n-nodes-scento-perfume.git"
  },
  "bugs": {
    "url": "https://github.com/Scento-com/n8n-nodes-scento-perfume/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "n8n-node build && node --test test/*.test.js",
    "test:live": "n8n-node build && SCENTO_LIVE=1 node --test test/*.test.js",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": [
      "dist/nodes/ScentoPerfume/ScentoPerfume.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
